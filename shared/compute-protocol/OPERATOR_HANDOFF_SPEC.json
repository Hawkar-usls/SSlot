{
  "schema": "janus.playgrid.operator-handoff.v2",
  "protocol_version": "0.3.0",
  "routing_fabric_version": "0.1.0",
  "purpose": "Allow a licensed buyer to redirect consented compute to approved providers without changing slot/game mathematics.",
  "buyer_replaceable": [
    "provider_manifests",
    "gateway_alias_to_server_endpoint_mapping",
    "provider_allowlist",
    "provider_public_verification_keys",
    "routing_plan",
    "workload_class_allowlist",
    "research_beneficiary",
    "compute_treasury_destination",
    "player_compute_earnings_policy",
    "general_compute_sink_policy",
    "ledger_endpoint",
    "regional_policy",
    "branding"
  ],
  "server_private_only": [
    "provider_credentials",
    "wallet_private_material",
    "yagna_app_key",
    "settlement_secrets",
    "anti_fraud_rules",
    "commercial_pricing"
  ],
  "immutable_reference_boundaries": [
    "COMPUTE_REQUIRES_EXPLICIT_OPT_IN",
    "IMMEDIATE_REVOKE",
    "COMPUTE_SCHEDULER_INDEPENDENT_FROM_SPIN_FREQUENCY",
    "COMPUTE_CANNOT_CHANGE_RNG",
    "COMPUTE_CANNOT_CHANGE_RTP",
    "COMPUTE_CANNOT_CHANGE_WIN_PROBABILITY",
    "COMPUTE_CANNOT_CHANGE_BET_SIZE",
    "COMPUTE_CANNOT_CHANGE_FREE_SPINS",
    "COMPUTE_CANNOT_CHANGE_PERSONAL_JACKPOT_WEIGHT",
    "PLAYER_COMPUTE_EARNINGS_NOT_AUTOMATIC_GAMBLING_BALANCE",
    "BROWSER_SECRETS_FORBIDDEN",
    "UNVERIFIED_RECEIPTS_HAVE_ZERO_LEDGER_VALUE",
    "ROUTE_WEIGHT_FROM_GAME_EVENT_FORBIDDEN"
  ],
  "task_types": ["SCIENCE_WORK_UNIT", "GENERAL_COMPUTE_JOB", "ECONOMIC_COMPUTE_JOB", "POW_SHARE"],
  "route_classes": ["SCIENCE", "PUBLIC_GOOD", "MARKETPLACE", "TREASURY", "DATACENTER", "OPERATOR", "CUSTOM"],
  "reference_providers": [
    "providers/science.requestor.json",
    "providers/public-good.generic.json",
    "providers/golem.marketplace.json",
    "providers/treasury.generic.json",
    "providers/datacenter.generic.json",
    "providers/operator.approved.json",
    "providers/custom.operator.json"
  ],
  "production_admission_gate": [
    "SIGNED_MANIFEST",
    "PROVIDER_IDENTITY",
    "TERMS_AND_LICENSE",
    "SECURITY_REVIEW",
    "PRIVACY_REVIEW",
    "WORKLOAD_VALIDATION",
    "RECEIPT_VERIFICATION",
    "SETTLEMENT_ACCOUNTING_IF_APPLICABLE",
    "LEGAL_REGULATORY_REVIEW",
    "ENERGY_THERMAL_POLICY"
  ]
}
